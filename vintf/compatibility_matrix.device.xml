    <hal format="hidl">
        <name>vendor.qti.gnss</name>
        <version>1.0</version>
        <interface>
            <name>ILocHidlFlpService</name>
            <instance>default</instance>
        </interface>
    </hal>

    <hal format="hidl">
        <name>vendor.qti.gnss</name>
        <version>1.0</version>
        <interface>
            <name>ILocHidlBatchingService</name>
            <instance>default</instance>
